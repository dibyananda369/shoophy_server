*.zip
*.rar
*.7z
*.tar
*.tar.gz

# Build output
dist/
build/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Testing
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache
.npm

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.sw?

# OS files
.DS_Store
Thumbs.db
desktop.ini
